      <section class="hero" id="top">
        <div class="hero-grid"></div>
        <div class="eyebrow">Personal Engineering Curriculum · 2026</div>
        <h1>
          <span class="gradient">Frontend → Backend</span><br />Mastery Roadmap
        </h1>
        <p>
          A single visual curriculum combining the complete frontend and backend
          project paths—from HTML and CSS fundamentals to React, Next.js,
          Node.js, databases, distributed systems, AI, Three.js and
          production-grade full-stack platforms.
        </p>
        <div class="stats">
          <div class="stat"><b>300+</b><span>project milestones</span></div>
          <div class="stat"><b>20+</b><span>technology domains</span></div>
