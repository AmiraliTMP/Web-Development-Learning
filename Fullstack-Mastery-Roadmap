<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Frontend → Backend Mastery Roadmap</title>
    <style>
      :root {
        --bg: #07080c;
        --panel: #0d1017;
        --panel2: #11151e;
        --text: #eef2f7;
        --muted: #8e99aa;
        --line: #202735;
        --accent: #61dafb;
        --accent2: #8b5cf6;
        --green: #22c55e;
        --orange: #f59e0b;
        --pink: #ec4899;
        --red: #ef4444;
        --cyan: #06b6d4;
        --shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
      }
      * {
        box-sizing: border-box;
        scroll-behavior: smooth;
      }
      html {
        scroll-padding-top: 30px;
      }
      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 15% 5%,
            rgba(97, 218, 251, 0.09),
            transparent 28%
          ),
          radial-gradient(
            circle at 85% 15%,
            rgba(139, 92, 246, 0.11),
            transparent 30%
          ),
          var(--bg);
        color: var(--text);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        line-height: 1.6;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button,
      input {
        font: inherit;
      }
      aside {
        position: fixed;
        inset: 0 auto 0 0;
        width: 290px;
        background: rgba(7, 8, 12, 0.94);
        backdrop-filter: blur(18px);
        border-right: 1px solid var(--line);
        padding: 24px 16px;
        z-index: 20;
        overflow: auto;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 10px 22px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 16px;
      }
      .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        display: grid;
        place-items: center;
        font-weight: 900;
        color: #05060a;
        box-shadow: 0 8px 30px rgba(97, 218, 251, 0.2);
      }
      .brand strong {
        display: block;
        font-size: 14px;
      }
      .brand span {
        font-size: 11px;
        color: var(--muted);
      }
      .search {
        position: sticky;
        top: 0;
        background: var(--bg);
        padding: 8px 0 14px;
        z-index: 2;
      }
      .search input {
        width: 100%;
        background: var(--panel);
        border: 1px solid var(--line);
        color: var(--text);
        padding: 11px 12px;
        border-radius: 10px;
        outline: none;
      }
      .nav-title {
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #697386;
        margin: 14px 10px 7px;
      }
      nav a {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 10px;
        border-radius: 9px;
        color: #aab3c2;
        font-size: 13px;
        margin: 2px 0;
      }
      nav a:hover {
        background: #151a23;
        color: #fff;
      }
      .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--c, #61dafb);
        box-shadow: 0 0 10px var(--c, #61dafb);
      }
      main {
        margin-left: 290px;
        max-width: 1500px;
        padding: 50px 55px 100px;
      }
      .hero {
        min-height: 520px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }
      .eyebrow {
        color: var(--accent);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      h1 {
        font-size: clamp(46px, 6vw, 92px);
        line-height: 0.95;
        letter-spacing: -0.055em;
        margin: 18px 0;
        max-width: 1000px;
      }
      .gradient {
        background: linear-gradient(
          100deg,
          #fff 15%,
          #61dafb 45%,
          #8b5cf6 75%,
          #ec4899
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .hero p {
        max-width: 760px;
        color: #aeb7c6;
        font-size: 18px;
      }
      .hero-grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.25;
        background-image:
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 44px 44px;
        mask-image: linear-gradient(to bottom, #000, transparent 80%);
      }
      .stats {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
      }
      .stat {
        background: rgba(13, 16, 23, 0.8);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 12px 16px;
      }
      .stat b {
        font-size: 20px;
      }
      .stat span {
        display: block;
        color: var(--muted);
        font-size: 11px;
      }
      .section {
        margin-top: 80px;
        scroll-margin-top: 30px;
      }
      .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--line);
        padding-bottom: 18px;
        margin-bottom: 24px;
      }
      .section-kicker {
        color: var(--accent);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      h2 {
        font-size: 38px;
        line-height: 1.05;
        margin: 6px 0 0;
        letter-spacing: -0.03em;
      }
      h3 {
        margin: 0 0 8px;
        font-size: 18px;
      }
      .logo-row {
        display: flex;
        align-items: center;
        gap: 18px;
      }
      .logo {
        width: 54px;
        height: 54px;
        object-fit: contain;
        filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.3));
      }
      .logo.react {
        animation: spin 14s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 14px;
      }
      .card {
        background: linear-gradient(
          145deg,
          rgba(17, 21, 30, 0.96),
          rgba(11, 13, 19, 0.96)
        );
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--shadow);
      }
      .card:hover {
        border-color: #344052;
        transform: translateY(-2px);
        transition: 0.2s;
      }
      .card p,
      .card li {
        color: #9da7b7;
        font-size: 13px;
      }
      .card.project h3 {
        font-size: 15px;
        margin-right: 28px;
        line-height: 1.3;
      }
      .card.project p {
        margin: 6px 0 0;
        min-height: 1.2em;
      }
      .card ul {
        padding-left: 18px;
        margin: 10px 0 0;
      }
      .project {
        position: relative;
      }
      .num {
        position: absolute;
        right: 16px;
        top: 15px;
        color: #475164;
        font-size: 11px;
        font-weight: 800;
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 12px;
      }
      .tag {
        font-size: 10px;
        padding: 4px 7px;
        border-radius: 6px;
        background: #181e29;
        color: #9da7b7;
        border: 1px solid #252d3a;
      }
      .skills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
      }
      .skill {
        padding: 7px 10px;
        border: 1px solid var(--line);
        border-radius: 9px;
        color: #aeb7c6;
        background: #0c1017;
        font-size: 12px;
      }
      .timeline {
        border-left: 1px solid #2a3341;
        margin-left: 15px;
        padding-left: 25px;
      }
      .phase {
        position: relative;
        margin: 28px 0;
      }
      .phase:before {
        content: "";
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        left: -31px;
        top: 7px;
        background: var(--accent);
        box-shadow: 0 0 18px var(--accent);
      }
      .callout {
        padding: 18px 20px;
        border: 1px solid #273141;
        border-radius: 14px;
        background: linear-gradient(
          90deg,
          rgba(97, 218, 251, 0.06),
          rgba(139, 92, 246, 0.05)
        );
      }
      .arch {
        overflow: auto;
        background: #05070b;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 22px;
        color: #9fe8ff;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 13px;
        white-space: pre;
      }
      .checklist label {
        display: flex;
        gap: 10px;
        padding: 7px 0;
        color: #aeb7c6;
        font-size: 13px;
      }
      .checklist input {
        accent-color: var(--accent);
      }
      footer {
        margin-top: 100px;
        padding-top: 30px;
        border-top: 1px solid var(--line);
        color: #697386;
        font-size: 12px;
      }
      @media (max-width: 900px) {
        aside {
          position: relative;
          width: 100%;
          height: auto;
          max-height: 55vh;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }
        main {
          margin-left: 0;
          padding: 28px 20px 70px;
        }
        .hero {
          min-height: 420px;
        }
        h1 {
          font-size: 48px;
        }
        .section {
          margin-top: 55px;
        }
      }

      /* Complete curriculum expansion */
      #complete-curriculum {
        scroll-margin-top: 32px;
      }
      #complete-curriculum .lead {
        max-width: 950px;
        opacity: 0.82;
      }
      .curriculum-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
        gap: 18px;
        margin-top: 26px;
      }
      .topic-card {
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 18px;
        padding: 22px;
        background: linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.055),
          rgba(255, 255, 255, 0.018)
        );
        box-shadow: 0 14px 40px rgba(0, 0, 0, 0.16);
        transition:
          transform 0.22s ease,
          border-color 0.22s ease,
          box-shadow 0.22s ease;
      }
      .topic-card:hover {
        transform: translateY(-3px);
        border-color: rgba(120, 180, 255, 0.32);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
      }
      .topic-card h3 {
        margin: 0 0 14px;
        font-size: 1.05rem;
      }
      .topic-card ul {
        margin: 0;
        padding-left: 19px;
      }
      .topic-card li {
        margin: 7px 0;
        line-height: 1.45;
        opacity: 0.86;
      }
      .mega-roadmap {
        margin-top: 28px;
        padding: 26px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: linear-gradient(
          135deg,
          rgba(80, 130, 255, 0.09),
          rgba(170, 80, 255, 0.06)
        );
      }
      .mega-roadmap li {
        margin: 10px 0;
        line-height: 1.55;
      }
      .nav-group {
        margin-top: 18px;
      }
      .nav-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        opacity: 0.55;
        margin: 0 0 8px;
      }
      .nav-group a {
        display: block;
        padding: 6px 8px;
        border-radius: 8px;
      }
      .nav-group a:hover {
        background: rgba(255, 255, 255, 0.06);
      }
      @media (max-width: 800px) {
        .curriculum-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
