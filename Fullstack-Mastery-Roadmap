    <script>
      const search = document.getElementById("search");
      const aside = document.querySelector("aside");

      function filterSidebar() {
        const q = search.value.trim().toLowerCase();
        const links = aside.querySelectorAll("nav a");
        const titles = aside.querySelectorAll(".nav-title");
        const groups = aside.querySelectorAll(".nav-group");

        links.forEach((a) => {
          const match = !q || a.textContent.toLowerCase().includes(q);
          a.style.display = match ? "" : "none";
        });

        // Hide curriculum groups with no matching links
        groups.forEach((group) => {
          const visible = [...group.querySelectorAll("a")].some(
            (a) => a.style.display !== "none",
          );
          group.style.display = !q || visible ? "" : "none";
        });

        // Hide Frontend / Backend titles when nothing under them matches
        titles.forEach((title) => {
          let el = title.nextElementSibling;
          let anyVisible = false;
          while (el && !el.classList.contains("nav-title")) {
            if (el.tagName === "NAV") {
              const shown = [...el.querySelectorAll("a")].some(
                (a) => a.style.display !== "none",
              );
              if (shown) anyVisible = true;
            }
            el = el.nextElementSibling;
          }
          title.style.display = !q || anyVisible ? "" : "none";
        });
      }

      search.addEventListener("input", filterSidebar);

      // Clear filter after jumping to a section
      aside.querySelectorAll("nav a").forEach((a) => {
        a.addEventListener("click", () => {
          search.value = "";
          filterSidebar();
        });
      });
    </script>
